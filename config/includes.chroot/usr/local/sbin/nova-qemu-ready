#!/bin/sh
# Sinaliza que o Live chegou ao LightDM durante o teste automatizado em QEMU.
# Em hardware real, sem ttyS0, termina silenciosamente e não altera o boot.
set -u

[ -c /dev/ttyS0 ] || exit 0

# O LightDM pode demorar alguns segundos para ficar ativo: tenta por até ~2 minutos.
i=0
while [ "$i" -lt 60 ]; do
    if systemctl is-active --quiet lightdm.service; then
        printf '\nNOVA_GAMER_OS_GRAPHICAL_READY\n' > /dev/ttyS0
        exit 0
    fi
    i=$((i + 1))
    sleep 2
done

# Não ficou ativo: despeja diagnóstico no console serial para o log do teste.
{
    printf '\nNOVA_LIGHTDM_NAO_ATIVO\n'
    systemctl --no-pager status lightdm.service 2>&1 | tail -n 20
    systemctl --no-pager --failed 2>&1 | head -n 20
    journalctl -u lightdm.service --no-pager -n 30 2>&1
    ls -l /etc/X11/default-display-manager 2>&1
} > /dev/ttyS0 2>&1
exit 0
